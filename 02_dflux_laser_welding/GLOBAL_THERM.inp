*PHYSICAL CONSTANTS, ABSOLUTE ZERO=-273.15, STEFAN BOLTZMANN=5.67E-11
**
** ==================================================================
** ABAQUS/STANDARD THERMAL MODEL: CIRCUMFERENTIAL LASER WELDING
** Generic Benchmark Model with Phase Transformations (16MnCr5)
** Units: mm, s, tonne, mJ, C
** ==================================================================
**
*INCLUDE, INPUT=MATERIAL_16MnCr5.inp
*INCLUDE, INPUT=GEOMETRY_THERM.inp
**
** ------------------------------------------------------------------
** SECTION ASSIGNMENTS
** ------------------------------------------------------------------
*SOLID SECTION, ELSET=SHAFT_SECTION, MATERIAL="ABQ_PHASE_TRANS_16MNCR5"
*SOLID SECTION, ELSET=HUB_SECTION, MATERIAL="ABQ_PHASE_TRANS_16MNCR5"
**
** ------------------------------------------------------------------
** INITIAL CONDITIONS
** - RLS (SDV1) = 1.0 (Solid state; 0 = liquid, -1 = raw powder)
** - Initial phase: 100% Ferrite-Pearlite (SDV4 = 1.0)
** - Initial temperature: 25.0 C uniform
** ------------------------------------------------------------------
*INITIAL CONDITIONS, TYPE=SOLUTION
ELSET_ALL, 1., , , 1., 0., 0., 0.,
**
*INITIAL CONDITION, TYPE=FIELD, VARIABLE=3
NSET_ALL, 0., 0., 0.,
**
*INITIAL CONDITIONS, TYPE=TEMPERATURE, SECTION SPECIFICATION=UNIFORM
NSET_ALL, 25.0
**
** ------------------------------------------------------------------
** THERMAL TIES - Heat continuity across the cylindrical weld joint
** ------------------------------------------------------------------
*TIE, NAME=TIE_JOINT, TYPE=SURFACE TO SURFACE, ADJUST=YES, POSITION TOLERANCE=0.05
SURF_HUB_JOINT, SURF_SHAFT_JOINT
**
** ==================================================================
** STEP 1: WELDING & IMMEDIATE POST-WELD SOLIDIFICATION
** Beam active for 380 deg (360 deg full weld + 20 deg ramp-down):
** t_beam = (380 * pi / 180) / omega = 4.974 s.
** The step duration is extended to 6.00 s with a fixed time increment
** (dt = 0.012 s) to resolve the thermal cycle during solidification
** and BTR (Brittleness Temperature Range) prior to increasing dt in Step 2.
** ==================================================================
*STEP, NAME=WELDING_STEP_THERMAL, AMPLITUDE=STEP, INC=10000
*HEAT TRANSFER, DELTMX=5000.
0.012, 6.00, 1.0E-08, 0.012
*CONTROLS, PARAMETERS=TIME INCREMENTATION
20, 30, 10, 50, 20, 10, , 5
*CONTROLS, PARAMETERS=LINE SEARCH
10, 1, 0.001, 0.25, 0.01
*DFLUX, OP=NEW
DFLUX_ELSET, BFNU, 1.0
*SFILM, OP=NEW
SURF_FILM, F, 25.0, 0.025
*SRADIATE, OP=NEW
SURF_FILM, R, 25.0, 0.80
*OUTPUT, FIELD, TIME INTERVAL=0.06, TIME MARKS=YES
*NODE OUTPUT
NT,
*ELEMENT OUTPUT
SDV1, SDV4, SDV5, SDV6, SDV7
*NODE FILE, FREQUENCY=1
NT,
*OUTPUT, HISTORY, FREQUENCY=0
*END STEP
**
** ==================================================================
** STEP 2: COOLING DOWN TO ROOM TEMPERATURE
** Automatic time incrementation governed by max temperature change
** DELTMX = 25.0 C to properly track solid-state phase kinetics.
** ==================================================================
*STEP, NAME=COOLING_STEP_THERMAL, AMPLITUDE=STEP, INC=2000
*HEAT TRANSFER, DELTMX=25.0
0.1, 300.0, 1.0E-05, 10.0
*DFLUX, OP=NEW
*SFILM, OP=NEW
SURF_FILM, F, 25.0, 0.025
*SRADIATE, OP=NEW
SURF_FILM, R, 25.0, 0.80
*OUTPUT, FIELD, TIME INTERVAL=5.0
*NODE OUTPUT
NT,
*ELEMENT OUTPUT
SDV1, SDV4, SDV5, SDV6, SDV7
*NODE FILE, FREQUENCY=1
NT,
*OUTPUT, HISTORY, FREQUENCY=0
*END STEP
